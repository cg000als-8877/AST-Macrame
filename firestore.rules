rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Store Configuration (Public catalog data & live stock controls)
    // Anyone can read store settings; only authenticated admin can update.
    match /settings/store_config {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. Customer Orders
    // - Public customers can SUBMIT (create) a new order.
    // - CRITICAL SECURITY: ONLY authenticated admin can READ orders.
    //   (This prevents unauthorized access to customer names, phone numbers, addresses, and purchase history).
    // - ONLY authenticated admin can UPDATE or DELETE orders.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderId', 'totalCost'])
                    && (!('status' in request.resource.data) || request.resource.data.status == 'Pending');
      allow read, update, delete: if request.auth != null;
    }
    
    // 3. Anonymous Daily Traffic Analytics
    // Public visits increment daily view/order counters; only admin can read full analytics.
    match /analytics/{day} {
      allow create, update: if true;
      allow read: if request.auth != null;
    }

    // 4. Default Fallback
    // Lock down all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
